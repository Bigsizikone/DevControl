{
  "name": "service-desk-access-routing",
  "version": "0.1.0",
  "private": true,
  "description": "Первый вертикальный срез модуля ролей, прав и маршрутизации Service Desk",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:architecture": "tsc -p tsconfig.architecture.json",
    "start": "node dist/main.js",
    "start:gateway": "node dist-architecture/apps/api-gateway/src/main.js",
    "start:dev": "nest start --watch",
    "test": "jest --runInBand",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:architecture": "tsc -p tsconfig.architecture.json --noEmit",
    "start:equipment": "node dist/plugins/equipment.main.js",
    "start:surveillance": "node dist/plugins/surveillance.main.js",
    "start:security": "node dist/plugins/security.main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1119.0",
    "@aws-sdk/s3-request-presigner": "^3.1119.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "amqplib": "^2.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "http-proxy-middleware": "^4.2.0",
    "ioredis": "^6.0.0",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/amqplib": "^0.10.8",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
