# Legacy compatibility database
DATABASE_URL=postgresql://service_desk:service_desk@localhost:5432/service_desk

# Service-owned databases (dev defaults only; replace credentials in production)
IDENTITY_DB_USER=identity_app
IDENTITY_DB_PASSWORD=identity_dev
SERVICE_DESK_DB_USER=servicedesk_app
SERVICE_DESK_DB_PASSWORD=servicedesk_dev
DEVELOPMENT_DB_USER=development_app
DEVELOPMENT_DB_PASSWORD=development_dev
CAMERA_DB_USER=camera_app
CAMERA_DB_PASSWORD=camera_dev
AUDIT_DB_USER=audit_app
AUDIT_DB_PASSWORD=audit_dev
NOTIFICATION_DB_USER=notification_app
NOTIFICATION_DB_PASSWORD=notification_dev
ANALYTICS_DB_USER=analytics_app
ANALYTICS_DB_PASSWORD=analytics_dev
FILE_DB_USER=file_app
FILE_DB_PASSWORD=file_dev

# Infrastructure
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://service_desk:service_desk@localhost:5672
EVENT_EXCHANGE=service-desk.events
GATEWAY_TIMEOUT_MS=15000
GATEWAY_RATE_LIMIT=600
GATEWAY_MAX_BODY_BYTES=52428800
GATEWAY_REQUIRE_AUTH=false
GATEWAY_DEV_TOKEN=
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=service-desk-files

# Cache TTL, seconds
CACHE_USER_TTL=600
CACHE_PERMISSION_TTL=300
CACHE_DICTIONARY_TTL=1800
CACHE_KANBAN_TTL=60
CACHE_CAMERA_TTL=300
